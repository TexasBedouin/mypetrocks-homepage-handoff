-import { useCallback, useEffect, useRef, useState } from 'react';
-import { useDropzone } from 'react-dropzone';
-import { Upload, ArrowRight } from 'lucide-react';
-import { toast } from 'sonner';
-import { clarityEvent } from '@/lib/clarity';
-import { capture } from '@/lib/analytics';
-
-interface ConversionHeroProps {
-  onGetStarted: (file?: File) => void;
-}
-
-// Curated "real pet beside its own portrait" hero shots — public storage URLs,
-// stable and CDN-cached. Every slide shows a real animal next to real product,
-// which is the proof a cold visitor needs before they'll hand us a photo.
-// Rotation changes ONLY the artwork; headline + CTA never move.
-const SLIDES = [
-  {
-    src: 'https://kvkdxegocalshvshtjme.supabase.co/storage/v1/render/image/public/style-assets/styles/5204df12-a20d-4694-a5f5-cba6d1b5e014/1770221609664-s7kux.webp?width=1600&height=1600&resize=contain&quality=88',
-    alt: 'Border collie sitting beneath her own Kanazawa Gold Leaf portrait',
-    style: 'Kanazawa Gold Leaf',
-  },
-  {
-    src: 'https://kvkdxegocalshvshtjme.supabase.co/storage/v1/object/public/style-assets/gallery/Sumi-e%20ink%20wash%20painting/protected_1_9add.webp',
-    alt: 'Orange cat beside its framed sumi-e ink portrait',
-    style: 'Sumi-e Ink Wash',
-  },
-  {
-    src: '/hero/beans-gallery-wall.webp',
-    alt: 'Pit bull sitting on the couch beneath his own engraved portrait in a gallery wall',
-    style: 'Victorian Engraving',
-  },
-  {
-    src: 'https://kvkdxegocalshvshtjme.supabase.co/storage/v1/object/public/style-assets/gallery/Imperial%20Bamboo/Untitled1.webp',
-    alt: 'Black cat beside its bamboo-forest portrait in a tea room',
-    style: 'Imperial Bamboo Forest',
-  },
-  {
-    // Founder-picked shot, served from the app itself (public/hero/) rather
-    // than storage — same white lab as the proof slider, in a vinyl den.
-    src: '/hero/cosmic-voyager-listening-room.webp',
-    alt: 'White lab sitting beneath its framed astronaut portrait in a listening room',
-    style: 'Retro Cosmic Voyager',
-  },
-  {
-    src: 'https://kvkdxegocalshvshtjme.supabase.co/storage/v1/object/public/style-assets/gallery/Dramatic%20manga/Untitle3d.webp',
-    alt: 'Calico cat sitting beside her dramatic manga portrait on a bookshelf',
-    style: 'Dramatic Manga',
-  },
-];
-
-const SLIDE_DWELL_MS = 4500;
-const MAX_UPLOAD_BYTES = 24 * 1024 * 1024;
-
-/** The next slide index after `from` whose image hasn't failed (wraps; returns
- *  `from` unchanged if every other slide is dead). */
-function nextOkSlide(from: number, failed: ReadonlySet<number>): number {
-  for (let hop = 1; hop <= SLIDES.length; hop += 1) {
-    const candidate = (from + hop) % SLIDES.length;
-    if (!failed.has(candidate)) return candidate;
-  }
-  return from;
-}
-
-/**
- * Landing hero: a slow rotation of real pets photographed beside their own
- * portraits, with a fixed message and one gold CTA. Replaces GalleryHero.
- * Rotation pauses in background tabs and disables for reduced-motion users
- * (they keep the first slide as a static hero).
- */
-export function ConversionHero({ onGetStarted }: ConversionHeroProps) {
-  const [active, setActive] = useState(0);
-  // Slide 0 paints immediately; the rest mount after first paint settles so
-  // they don't compete with the LCP image on slow connections. Reduced-motion
-  // visitors never rotate, so for them the extra slides stay unmounted (and
-  // undownloaded) unless slide 0 fails and we need a stand-in.
-  const [restMounted, setRestMounted] = useState(false);
-  // Slides whose image failed to load — skipped by the rotation and never
-  // rendered, so one dead storage URL costs a slide, not a blank hero frame.
-  const [failed, setFailed] = useState<ReadonlySet<number>>(() => new Set<number>());
-  const failedRef = useRef(failed);
-  failedRef.current = failed;
-  const reducedMotion = useRef(false);
-
-  useEffect(() => {
-    reducedMotion.current =
-      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
-    if (reducedMotion.current) return;
-    const mountId = window.setTimeout(() => setRestMounted(true), 2000);
-    return () => window.clearTimeout(mountId);
-  }, []);
-
-  useEffect(() => {
-    if (reducedMotion.current || !restMounted) return;
-    const id = window.setInterval(() => {
-      if (document.hidden) return;
-      setActive((i) => nextOkSlide(i, failedRef.current));
-    }, SLIDE_DWELL_MS);
-    return () => window.clearInterval(id);
-  }, [restMounted]);
-
-  // If the slide on screen failed to load, move off it immediately — this also
-  // rescues reduced-motion visitors whose static slide 0 is the one that died.
-  useEffect(() => {
-    if (!failed.has(active) || failed.size >= SLIDES.length) return;
-    setActive((i) => nextOkSlide(i, failed));
-  }, [failed, active]);
-
-  function markFailed(index: number) {
-    setFailed((prev) => {
-      if (prev.has(index)) return prev;
-      const next = new Set(prev);
-      next.add(index);
-      return next;
-    });
-    // A dead first slide needs a replacement mounted even when rotation is off.
-    if (index === 0) setRestMounted(true);
-  }
-
-  const onDrop = useCallback(
-    (acceptedFiles: File[]) => {
-      if (acceptedFiles.length === 0) return;
-      const file = acceptedFiles[0];
-      if (file.size > MAX_UPLOAD_BYTES) {
-        toast.error('Image must be less than 24MB');
-        return;
-      }
-      // Earliest committed funnel signal — the visitor handed us a photo.
-      // Mirrors the GalleryHero instrumentation this hero replaces.
-      const device = window.innerWidth < 768 ? 'mobile' : 'desktop';
-      clarityEvent('hero_upload_started');
-      capture('funnel_hero_upload_started', { surface: 'hero', device });
-      onGetStarted(file);
-    },
-    [onGetStarted],
-  );
-
-  const { getRootProps, getInputProps, isDragActive } = useDropzone({
-    onDrop,
-    accept: { 'image/*': ['.jpeg', '.jpg', '.png', '.webp'] },
-    maxFiles: 1,
-  });
-
-  // Every slide 404'd (storage outage / bad deploy). Nothing is rendered behind
-  // the copy, so drop the style caption too rather than label an empty frame —
-  // the hero degrades to plain type on the background, which still sells.
-  const allSlidesDead = failed.size >= SLIDES.length;
-
-  return (
-    // Mobile stacks (art on top, copy below) because every slide puts its pet
-    // in a different spot — any fixed overlay position covers somebody's face.
-    // Desktop keeps the full-bleed poster overlay, where the frame is wide
-    // enough for the subject and the copy to coexist.
-    <section className="relative flex flex-col overflow-hidden md:min-h-[86vh] md:justify-end">
-      {/* Art. overflow-hidden matters: the Ken Burns zoom scales the image past
-          this box, and the scrim only covers the box — without the clip that
-          overspill renders as a raw, un-faded strip under the photo. */}
-      <div className="relative h-[46vh] w-full shrink-0 overflow-hidden md:absolute md:inset-0 md:h-auto">
-        {SLIDES.map((slide, i) => {
-          if (i !== 0 && !restMounted) return null;
-          if (failed.has(i)) return null;
-          const isActive = i === active;
-          return (
-            <div
-              key={slide.src}
-              aria-hidden={!isActive}
-              className={`absolute inset-0 transition-opacity duration-[1400ms] ease-out ${
-                isActive ? 'opacity-100' : 'opacity-0'
-              }`}
-            >
-              <img
-                src={slide.src}
-                alt={isActive ? slide.alt : ''}
-                width={1600}
-                height={1600}
-                loading={i === 0 ? 'eager' : 'lazy'}
-                // Lowercase DOM attribute — this React version doesn't map the
